# API keys and secrets
api_keys.yaml
.env
config/api_sources.yaml
secrets/
projects/*/secrets/
*.service-account.json
*service-account*.json
*credentials*.json

# Python
__pycache__/
*.pyc

# Data directories — ignore real data, keep folder placeholders
data/raw/**
data/clean/**
data/mart/**

!data/raw/**/.gitkeep
!data/clean/**/.gitkeep
!data/mart/**/.gitkeep

# Tableau fixed datasource CSVs should be committed
# Do not ignore data/tableau_datasource/*.csv

# Report outputs
reports/pdf/**
reports/excel/**
reports/email/**

# Logs
logs/*.log

# Temp and archive
temp/**
archive/**

# Multi-project runtime outputs
projects/*/data/raw/**
projects/*/data/clean/**
projects/*/data/mart/**
projects/*/data/tableau_datasource/*.csv
projects/*/ai/context/*.json
projects/*/ai/draft/*.md
projects/*/reports/pdf/**
projects/*/reports/email/**
projects/*/logs/*.log

!projects/**/.gitkeep
!projects/*/project.yaml
!projects/*/data/raw/**/
!projects/*/data/raw/**/.gitkeep
!projects/*/data/clean/**/
!projects/*/data/clean/**/.gitkeep
!projects/*/data/tableau_datasource/.gitkeep
!projects/*/ai/context/.gitkeep
!projects/*/ai/draft/.gitkeep

# Always allow .gitkeep files to be tracked
!**/.gitkeep
