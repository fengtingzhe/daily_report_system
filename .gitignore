# API keys and secrets
.env
config/api_sources.yaml
config/api_keys.yaml

# Root legacy runtime dirs (no longer used)
data/
ai/
reports/
logs/
temp/
archive/
secrets/

# Project runtime dirs — ignore real data, keep folder placeholders
projects/*/secrets/
projects/*/data/raw/**
projects/*/data/clean/**
projects/*/data/mart/**
projects/*/data/tableau_datasource/*.csv
projects/*/ai/context/*.json
projects/*/ai/draft/*.md
projects/*/reports/pdf/**
projects/*/reports/email/**
projects/*/logs/**
projects/*/temp/**

# Credentials — never commit
*.service-account.json
*service-account*.json
*credentials*.json

# Python
__pycache__/
*.pyc

# Always allow .gitkeep and project.yaml to be tracked
!projects/**/.gitkeep
!projects/*/project.yaml
!**/.gitkeep
