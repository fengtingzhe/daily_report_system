# API keys and secrets
api_keys.yaml
.env

# Python
__pycache__/
*.pyc

# Data directories — ignore real data, keep folder placeholders
data/raw/**
data/clean/**
data/mart/**

!data/raw/**/.gitkeep
!data/clean/**/.gitkeep
!data/mart/**/.gitkeep

# Tableau fixed datasource CSVs should be committed
# Do not ignore data/tableau_datasource/*.csv

# Report outputs
reports/pdf/**
reports/excel/**
reports/email/**

# Logs
logs/*.log

# Temp and archive
temp/**
archive/**

# Always allow .gitkeep files to be tracked
!**/.gitkeep
