# API keys and secrets
api_keys.yaml
.env

# Python
__pycache__/
*.pyc

# Data directories — ignore data content, track .gitkeep for folder structure
data/raw/**
data/clean/**
data/mart/**

# Tableau data source CSVs — header files ARE committed for Tableau
# (not ignored)

# Report outputs
reports/pdf/**
reports/excel/**
reports/email/**

# Logs
logs/*.log

# Temp and archive
temp/**
archive/**

# Always allow .gitkeep files to be tracked
!.gitkeep
